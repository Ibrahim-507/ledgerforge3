# Copy this file to .env and replace EVERY value. .env is ignored by git and by Docker: it never enters the repository or the image.
# Make a secret key with:   python -c "import secrets; print(secrets.token_urlsafe(48))"
LEDGERFORGE_SECRET_KEY=change-me-run-the-command-above
POSTGRES_PASSWORD=change-me-too
# password given to every demo user (stored only as a salted hash)
DEMO_PASSWORD=change-me-demo-password
